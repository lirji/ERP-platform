<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lrj.erp</groupId>
    <artifactId>erp-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>erp-app</artifactId>
  <name>erp-app</name>
  <!--
    唯一的可运行/可部署单元（Runtime Boundary = Deployment Boundary = 1）。
    职责：Spring Boot 启动、REST 装配、全局异常、安全过滤链、Flyway 汇总、健康检查。
    本模块不含业务规则——业务规则一律在各业务模块内。
  -->
  <description>ERP 启动与组装模块，HTTP :8500</description>

  <dependencies>
    <!-- 组装全部业务模块：只有这里允许依赖所有模块 -->
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-kernel</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-numbering</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-iam</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-approval</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-masterdata</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-document</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-inventory</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-procurement</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-sales</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-finance</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-reporting</artifactId></dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Flyway：迁移脚本汇总执行。每模块脚本放在各自 db/migration 下，由 classpath 合并 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 架构测试：ArchUnit 在组装模块跑，才能一次看见全部模块的字节码 -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.lrj.erp.app.ErpApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
