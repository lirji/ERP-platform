<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lrj.erp</groupId>
    <artifactId>erp-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>erp-app</artifactId>
  <name>erp-app</name>
  <!--
    唯一的可运行/可部署单元（Runtime Boundary = Deployment Boundary = 1）。
    职责：Spring Boot 启动、REST 装配、全局异常、安全过滤链、Flyway 汇总、健康检查。
    本模块不含业务规则——业务规则一律在各业务模块内。
  -->
  <description>ERP 启动与组装模块，HTTP :8500</description>

  <properties><skipFrontend>false</skipFrontend></properties>

  <dependencies>
    <!-- 组装全部业务模块：只有这里允许依赖所有模块 -->
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-kernel</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-numbering</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-iam</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-approval</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-masterdata</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-document</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-inventory</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-procurement</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-sales</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-finance</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-reporting</artifactId></dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 复用 Spring Security 验签与 auth-platform 同款浏览器 OIDC 库，不自建协议实现。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>oidc-client-ts</artifactId>
      <version>3.2.1</version>
      <!-- 浏览器产物已内联 jwt-decode，排除 WebJar 的动态版本范围。 -->
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>

    <!-- Flyway：迁移脚本汇总执行。每模块脚本放在各自 db/migration 下，由 classpath 合并 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 架构测试：ArchUnit 在组装模块跑，才能一次看见全部模块的字节码 -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>

    <!--
      集成测试用真实 PostgreSQL —— 由 deploy/compose.yaml 提供，不用 Testcontainers。
      理由见 AbstractPostgresIT 的类注释（本机 Docker Desktop 与 docker-java 互操作失败）。
      Gate G-06 要求的是"不接受纯 Mock 证明事务正确"，真实 compose 数据库同样满足。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource><directory>src/main/resources</directory><filtering>false</filtering></resource>
      <!-- 前端构建结果只进入可执行制品，不提交生成资源到源码目录。 -->
      <resource><directory>../erp-web/dist</directory><targetPath>static/workbench</targetPath><filtering>false</filtering></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
        <configuration><workingDirectory>${project.basedir}/../erp-web</workingDirectory><skip>${skipFrontend}</skip></configuration>
        <executions>
          <execution><id>frontend-install</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
            <configuration><executable>npm</executable><arguments><argument>ci</argument><argument>--no-audit</argument></arguments></configuration>
          </execution>
          <execution><id>frontend-build</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
            <configuration><executable>npm</executable><arguments><argument>run</argument><argument>build</argument></arguments></configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        显式绑定 failsafe 的 execution。spring-boot-starter-parent 只做 pluginManagement，
        不绑定生命周期——不写这段，*IT 会被 surefire 排除、又不被 failsafe 执行，
        结果是集成测试一个都没跑却构建全绿（P0 已经吃过一次"空跑假绿"的亏）。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.lrj.erp.app.ErpApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
