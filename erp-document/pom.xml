<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lrj.erp</groupId>
    <artifactId>erp-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>erp-document</artifactId>
  <name>erp-document</name>
  <!-- 单据关系图、操作日志、审计、变更日志。横跨全部业务域的平台能力，不塞进任一业务模块。 -->
  <description>单据关系图、操作日志、审计、变更日志。横跨全部业务域的平台能力，不塞进任一业务模块。</description>

  <!-- 拥有的表前缀：doc_* （Data Ownership，见 MODULE_SERVICE_MAP.md） -->

  <dependencies>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-kernel</artifactId></dependency>
    <dependency><groupId>com.lrj.erp</groupId><artifactId>erp-iam</artifactId></dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- 审计前后值以 JSONB 存储，需要 Jackson 做序列化与脱敏；
         这里只要 databind，不引 web starter（库模块不应带 HTTP 依赖） -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- 本模块拥有 doc_* 表，需要持久层；SQL 只出现在 resources/mapper/*.xml -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
  </dependencies>
</project>
