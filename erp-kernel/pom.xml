<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lrj.erp</groupId>
    <artifactId>erp-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>erp-kernel</artifactId>
  <name>erp-kernel</name>
  <!-- 共享内核：单据基类、状态机机制、幂等框架、Money/Quantity、错误码、AccessContext、Outbox 框架。刻意保持很小——共享内核的代价是耦合发布。 -->
  <description>共享内核：单据基类、状态机机制、幂等框架、Money/Quantity、错误码、AccessContext、Outbox 框架。刻意保持很小——共享内核的代价是耦合发布。</description>

  <!-- 不拥有任何表 -->

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!--
      Outbox 框架需要持久层。erp-kernel 仍然不拥有任何**业务**表——
      erp_outbox_message 是平台基础设施表（erp_ 前缀，V1 基线），
      不属于任何业务上下文，因此由内核管理而不是塞进某个业务模块。
    -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
