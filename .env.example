# 复制为 .env 后按需修改；.env 已在 .gitignore 中，禁止提交真实口令。
# 本地默认复用 dev-infra 的 PostgreSQL 16 共享实例（ADR-001 / 假设 A-13）。

# --- 应用 ---
ERP_APP_PORT=8500
ERP_LOG_LEVEL=INFO

# --- 数据库（dev-infra postgres16，宿主端口 45432）---
ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=45432
ERP_DB_NAME=erp
ERP_DB_USER=erp
ERP_DB_PASSWORD=change-me-locally
ERP_DB_POOL_MAX=20

# --- 项目自带 compose 用（deploy/compose.yaml，与 dev-infra 二选一）---
POSTGRES_HOST_PORT=45532
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-locally

# 使用上述项目 Compose 时：ERP_DB_PORT 改为 POSTGRES_HOST_PORT，
# ERP_DB_NAME/USER/PASSWORD 与 POSTGRES_DB/USER/PASSWORD 保持一致，供宿主种子工具访问。
ERP_ENV=local

# --- auth-platform OIDC：先注册客户端及绑定本地身份，再启用 ---
ERP_OIDC_ENABLED=false
ERP_OIDC_ISSUER=http://localhost:8000
# 宿主 JVM 用 localhost；Docker Desktop 容器用 host.docker.internal。
ERP_OIDC_JWKS=http://host.docker.internal:8000/.well-known/jwks
ERP_OIDC_CLIENT_ID=erp-platform
ERP_PUBLIC_BASE_URL=http://localhost:8500
