# 复制为 .env 后按需修改；.env 已在 .gitignore 中，禁止提交真实口令。
# 本地默认复用 dev-infra 的 PostgreSQL 16 共享实例（ADR-001 / 假设 A-13）。

# --- 应用 ---
ERP_APP_PORT=8500
ERP_LOG_LEVEL=INFO

# --- 数据库（dev-infra postgres16，宿主端口 45432）---
ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=45432
ERP_DB_NAME=erp
ERP_DB_USER=erp
ERP_DB_PASSWORD=change-me-locally
ERP_DB_POOL_MAX=20

# --- 项目自带 compose 用（deploy/compose.yaml，与 dev-infra 二选一）---
POSTGRES_HOST_PORT=45532
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-locally
